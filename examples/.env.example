GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: override the tokens-file path for URL-server credentials.
# Defaults to a 'tokens' file in the same directory as your config.
# Set this to a path outside the project (e.g. ~/.secrets/extensible-mcp-tokens)
# to keep credentials out of any directory the LLM/agent can read via
# filesystem MCP servers.
# EXTENSIBLE_MCP_TOKENS_FILE=~/.secrets/extensible-mcp-tokens
