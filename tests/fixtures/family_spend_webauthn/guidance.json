{"tiers":
 [{"tier": 0,
   "checks":
   [{"sentence": "a credential signature is invalid",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.signed_by_did_key",
     "condition":
     "not signed_by_did_key(input.requestVC.jws, input.requestVC.claims.iss)"},
    {"sentence": "a credential is outside its validity window",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.within_window",
     "condition":
     "not within_window(input.requestVC.claims.nbf, input.requestVC.claims.exp, input.now)"},
    {"sentence":
     "required: input.requestVC.claims.vc.credentialSubject.requests.type == input.tool",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.type_matches",
     "condition":
     "input.requestVC.claims.vc.credentialSubject.requests.type != input.tool"},
    {"sentence":
     "required: input.requestVC.claims.vc.credentialSubject.requests.amountCents == input.arguments.amountCents",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.amount_cents_matches",
     "condition":
     "input.requestVC.claims.vc.credentialSubject.requests.amountCents != input.arguments.amountCents"},
    {"sentence":
     "required: input.requestVC.claims.vc.credentialSubject.requests.merchant == input.arguments.merchant",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.merchant_matches",
     "condition":
     "input.requestVC.claims.vc.credentialSubject.requests.merchant != input.arguments.merchant"},
    {"sentence": "a membership credential does not chain to a trusted admin",
     "remedy_class": "re-promptable",
     "id": "solo.requester_membership.member_of",
     "condition":
     "not member_of(input.requesterMembership, input.requestVC.claims.iss, input.trustedAdminDids, input.now)"},
    {"sentence":
     "required: input.requesterMembership.claims.vc.credentialSubject.role == \"child\"",
     "remedy_class": "re-promptable",
     "id": "solo.requester_membership.role_matches",
     "condition":
     "input.requesterMembership.claims.vc.credentialSubject.role != \"child\""},
    {"sentence":
     "required: input.requestVC.claims.vc.credentialSubject.requests.amountCents <= 1000",
     "remedy_class": "re-promptable",
     "id": "solo.request_vc.amount_cents_at_most",
     "condition":
     "input.requestVC.claims.vc.credentialSubject.requests.amountCents > 1000"}]},
  {"tier": 1,
