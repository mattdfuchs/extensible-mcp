{"tiers":
 [{"tier": 0,
   "checks":
   [{"sentence": "the invoice is not signed by a trusted merchant",
     "remedy_class": "re-promptable",
     "id": "solo.invoice.signed_by_trusted_merchant",
     "condition":
     "not signed_by_trusted_merchant(input.invoice, input.trustedMerchants)"},
    {"sentence": "the invoice has expired",
     "remedy_class": "re-promptable",
     "id": "solo.invoice.unexpired",
     "condition": "not invoice_unexpired(input.invoice.canonical, input.now)"},
    {"sentence": "the invoice total is not the amount this call would pay",
     "remedy_class": "re-promptable",
     "id": "solo.invoice.total_matches",
     "condition":
     "not invoice_total_matches(input.invoice.canonical, input.arguments.amountCents)"},
    {"sentence": "the invoice is not from the merchant this call names",
     "remedy_class": "re-promptable",
     "id": "solo.invoice.merchant_matches",
     "condition":
     "not invoice_merchant_matches(input.invoice.canonical, input.arguments.merchantId)"},
    {"sentence": "the passkey assertion is invalid",
     "remedy_class": "re-promptable",
     "id": "solo.child_approval.webauthn_verified",
     "condition":
     "not webauthn_verified(input.childApproval.authenticatorData, input.childApproval.clientDataJSON, input.childApproval.signature, input.childEnrollment.claims.vc.credentialSubject.publicKey, input.webauthnOrigin)"},
    {"sentence": "the approval is not bound to this invoice",
     "remedy_class": "re-promptable",
     "id": "solo.child_approval.invoice_challenge_binds",
     "condition":
     "not invoice_challenge_binds(input.childApproval.clientDataJSON, input.invoice.canonical)"},
    {"sentence": "the enrollment credential's issuer is not a trusted admin",
     "remedy_class": "re-promptable",
     "id": "solo.child_enrollment.enrolled_by_trusted_admin",
     "condition":
     "not enrolled_by_trusted_admin(input.childEnrollment, input.trustedAdminDids)"},
    {"sentence":
     "a credential's signature could not be verified against its issuer's key",
     "remedy_class": "re-promptable",
     "id": "solo.child_enrollment.signed_by_key",
     "condition":
     "not signed_by_key(input.childEnrollment.jws, input.childEnrollment.adminKey)"},
    {"sentence":
     "required: input.childEnrollment.claims.sub == input.childApproval.credentialId",
     "remedy_class": "re-promptable",
     "id": "solo.child_enrollment.sub_matches",
     "condition":
     "input.childEnrollment.claims.sub != input.childApproval.credentialId"},
    {"sentence": "a credential is outside its validity window",
     "remedy_class": "re-promptable",
     "id": "solo.child_enrollment.within_window",
     "condition":
     "not within_window(input.childEnrollment.claims.nbf, input.childEnrollment.claims.exp, input.now)"},
    {"sentence":
     "required: input.childEnrollment.claims.vc.credentialSubject.role == \"child\"",
     "remedy_class": "re-promptable",
     "id": "solo.child_enrollment.role_matches",
     "condition":
     "input.childEnrollment.claims.vc.credentialSubject.role != \"child\""},
    {"sentence": "required: input.arguments.amountCents <= 1000",
     "remedy_class": "re-promptable",
     "id": "solo.arguments.amount_cents_at_most",
     "condition": "input.arguments.amountCents > 1000"}]},
