{"engine": "cel-v1",
 "package": "policybundle.examples.family_spend",
 "tiers": [{"tier": 0, "checks": ["solo.request_vc.signed_by", "solo.request_vc.within_window", "solo.request_vc.action_matches", "solo.request_vc.arguments_matches", "solo.requester_membership.member_of", "solo.requester_membership.sub_matches", "solo.requester_membership.role_matches", "solo.arguments.amount_cents_at_most"]},
           {"tier": 1, "checks": ["full_chain.request_vc.signed_by", "full_chain.request_vc.within_window", "full_chain.request_vc.action_matches", "full_chain.request_vc.arguments_matches", "full_chain.requester_membership.member_of", "full_chain.requester_membership.sub_matches", "full_chain.requester_membership.role_matches", "full_chain.arguments.amount_cents_above", "full_chain.arguments.amount_cents_at_most", "full_chain.authorization_vc.signed_by", "full_chain.authorization_vc.within_window", "full_chain.request_vc.bound_to", "full_chain.approver_membership.member_of", "full_chain.approver_membership.sub_matches", "full_chain.approver_membership.role_matches"]}],
 "checks": {
   "solo.request_vc.signed_by": "verify_eddsa(input.requestVC.jws, input.trustRootJwk)",
   "solo.request_vc.within_window": "input.requestVC.claims.nbf <= input.now && input.now <= input.requestVC.claims.exp",
   "solo.request_vc.action_matches": "input.requestVC.claims.action == input.tool",
   "solo.request_vc.arguments_matches": "input.requestVC.claims.arguments == input.arguments",
   "solo.requester_membership.member_of": "input.requesterMembership.claims.iss == input.trustRootDID && input.requesterMembership.claims.nbf <= input.now && input.now <= input.requesterMembership.claims.exp && verify_eddsa(input.requesterMembership.jws, input.trustRootJwk)",
   "solo.requester_membership.sub_matches": "input.requesterMembership.claims.sub == input.requestVC.claims.iss",
   "solo.requester_membership.role_matches": "input.requesterMembership.claims.role == 'kid'",
   "solo.arguments.amount_cents_at_most": "input.arguments.amountCents <= 1000",

   "full_chain.request_vc.signed_by": "verify_eddsa(input.requestVC.jws, input.trustRootJwk)",
   "full_chain.request_vc.within_window": "input.requestVC.claims.nbf <= input.now && input.now <= input.requestVC.claims.exp",
   "full_chain.request_vc.action_matches": "input.requestVC.claims.action == input.tool",
   "full_chain.request_vc.arguments_matches": "input.requestVC.claims.arguments == input.arguments",
   "full_chain.requester_membership.member_of": "input.requesterMembership.claims.iss == input.trustRootDID && input.requesterMembership.claims.nbf <= input.now && input.now <= input.requesterMembership.claims.exp && verify_eddsa(input.requesterMembership.jws, input.trustRootJwk)",
   "full_chain.requester_membership.sub_matches": "input.requesterMembership.claims.sub == input.requestVC.claims.iss",
   "full_chain.requester_membership.role_matches": "input.requesterMembership.claims.role == 'kid'",
   "full_chain.arguments.amount_cents_above": "1000 < input.arguments.amountCents",
   "full_chain.arguments.amount_cents_at_most": "input.arguments.amountCents <= 20000",
   "full_chain.authorization_vc.signed_by": "verify_eddsa(input.authorizationVC.jws, input.trustRootJwk)",
   "full_chain.authorization_vc.within_window": "input.authorizationVC.claims.nbf <= input.now && input.now <= input.authorizationVC.claims.exp",
   "full_chain.request_vc.bound_to": "input.requestVC.claims.jti == input.authorizationVC.claims.jti && input.authorizationVC.claims.requestHash == sha256(input.requestVC.jws)",
   "full_chain.approver_membership.member_of": "input.approverMembership.claims.iss == input.trustRootDID && input.approverMembership.claims.nbf <= input.now && input.now <= input.approverMembership.claims.exp && verify_eddsa(input.approverMembership.jws, input.trustRootJwk)",
   "full_chain.approver_membership.sub_matches": "input.approverMembership.claims.sub == input.authorizationVC.claims.iss",
   "full_chain.approver_membership.role_matches": "input.approverMembership.claims.role == 'parent'"
 }}
